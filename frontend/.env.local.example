# Frontend Environment Variables
# Copiar a .env.local y configurar

# API URL (para desarrollo local usa /api, para producción puede cambiar)
NEXT_PUBLIC_API_URL=/api

# Socket.io URL for real-time notifications
NEXT_PUBLIC_SOCKET_URL=http://localhost:3005

# Supabase Configuration (obtener de Supabase Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# JWT Secret (solo para desarrollo local)
JWT_SECRET=tu_jwt_secret_aqui
